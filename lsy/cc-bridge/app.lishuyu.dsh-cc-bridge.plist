<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent template: install.sh replaces __HOME__ and loads it into gui/<uid>. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.lishuyu.dsh-cc-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/.local/libexec/dsh-cc-bridge/relay.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/dsh-cc-bridge/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/dsh-cc-bridge/launchd.err</string>
</dict>
</plist>
